# LLM
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# Provider selection
LLM_PROVIDER=gemini
EMBEDDING_PROVIDER=local

# Gemini Embeddings (used only when EMBEDDING_PROVIDER=gemini)
GEMINI_EMBEDDING_MODEL=gemini-embedding-2
GEMINI_EMBEDDING_DIMENSION=768

# Local free embeddings
LOCAL_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
LOCAL_EMBEDDING_DIMENSION=384

# RAG
RAG_SAMPLES_DIR=data/samples
RAG_COLLECTION_NAME=research_docs
QDRANT_PATH=qdrant_storage
RAG_CHUNK_SIZE=1200
RAG_CHUNK_OVERLAP=200
RAG_EMBEDDING_BATCH_SIZE=16
RAG_EMBEDDING_MAX_RETRIES=5
RAG_EMBEDDING_RETRY_SECONDS=2
RAG_TOP_K=5
RAG_MIN_RETRIEVAL_SCORE=0.20
RAG_MAX_CONTEXT_CHARS=12000

# Runtime
DATABASE_URL=sqlite:///./runtime/research_assistant.db
MAX_UPLOAD_MB=25
MAX_TOOL_ROUNDS=3
LOG_LEVEL=INFO
